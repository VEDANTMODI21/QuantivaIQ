# QuantivaIQ — Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ─── PostgreSQL Connection ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quantivaiq
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── Simulation Configuration ────────────────────────────────────────────────
# How many seconds between each live data generation cycle
SIMULATION_INTERVAL_SECONDS=5

# ─── Data Scale Configuration ────────────────────────────────────────────────
NUM_CUSTOMERS=5000
NUM_PRODUCTS=500
NUM_ORDERS=50000

# ─── ML Configuration ────────────────────────────────────────────────────────
FRAUD_CONTAMINATION_RATE=0.02
CHURN_THRESHOLD_DAYS=90
RFM_SCORE_BINS=5
